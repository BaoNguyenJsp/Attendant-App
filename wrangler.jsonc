{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "so-thieu-nhi",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "so-thieu-nhi", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "00000000000000000000000000000000" }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "so-thieu-nhi-photos" }
  ]
}
